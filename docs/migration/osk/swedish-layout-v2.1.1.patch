+// Swedish XKB layout: evdev positions stay the same; X11 supplies the symbols.
+func swedishLayout() [][]KeyDef {
+	layout := make([][]KeyDef, len(LayoutQWERTY))
+	for i, row := range LayoutQWERTY {
+		layout[i] = append([]KeyDef(nil), row...)
+	}
+	labels := map[int][2]string{
+		KEY_GRAVE: {"§", "½"}, KEY_2: {"2", `"`}, KEY_4: {"4", "¤"},
+		KEY_6: {"6", "&"}, KEY_7: {"7", "/"}, KEY_8: {"8", "("}, KEY_9: {"9", ")"}, KEY_0: {"0", "="},
+		KEY_MINUS: {"+", "?"}, KEY_EQUAL: {"´", "`"},
+		KEY_LEFTBRACE: {"å", "Å"}, KEY_RIGHTBRACE: {"¨", "^"}, KEY_BACKSLASH: {"'", "*"},
+		KEY_SEMICOLON: {"ö", "Ö"}, KEY_APOSTROPHE: {"ä", "Ä"},
+		KEY_COMMA: {",", ";"}, KEY_DOT: {".", ":"}, KEY_SLASH: {"-", "_"},
+	}
+	for _, row := range layout {
+		for i := range row {
+			if v, ok := labels[row[i].Code]; ok {
+				row[i].Label, row[i].ShiftLabel = v[0], v[1]
+			}
+		}
+	}
+	bottom := layout[4]
+	layout[4] = append([]KeyDef{mod("Shift", KEY_LEFTSHIFT, 1.25, "shift"), k("<", KEY_102ND, ">")}, bottom[1:]...)
+	return layout
+}
