{
  "version": 1,
  "settings": {
    "fps": 60,
    "animations": true,
    "language": "sv",
    "exit_combo": [
      "left_shoulder",
      "right_shoulder"
    ],
    "screensaver": {
      "enabled": true,
      "idle_seconds": 300,
      "photo_seconds": 6,
      "transition_ms": 1200,
      "ken_burns": true,
      "order": "random",
      "folders": [
        "~/Pictures"
      ],
      "show_filename": false
    }
  },
  "categories": [
    {
      "id": "streaming",
      "title": "Streaming",
      "items": [
        {
          "id": "youtube",
          "title": "YouTube",
          "launch": {
            "command": [
              "firefox",
              "--new-window",
              "https://www.youtube.com/"
            ]
          },
          "handover": {
            "type": "window",
            "window_class": "Navigator firefox_firefox",
            "profile": "firefox",
            "start_timeout_ms": 20000
          }
        },
        {
          "id": "netflix",
          "title": "Netflix",
          "launch": {
            "command": [
              "firefox",
              "--new-window",
              "https://www.netflix.com/browse"
            ]
          },
          "handover": {
            "type": "window",
            "window_class": "Navigator firefox_firefox",
            "profile": "firefox",
            "start_timeout_ms": 20000
          }
        },
        {
          "id": "disney-plus",
          "title": "Disney+",
          "launch": {
            "command": [
              "firefox",
              "--new-window",
              "https://www.disneyplus.com/"
            ]
          },
          "handover": {
            "type": "window",
            "window_class": "Navigator firefox_firefox",
            "profile": "firefox",
            "start_timeout_ms": 20000
          }
        },
        {
          "id": "prime-video",
          "title": "Prime Video",
          "launch": {
            "command": [
              "firefox",
              "--new-window",
              "https://www.primevideo.com/"
            ]
          },
          "handover": {
            "type": "window",
            "window_class": "Navigator firefox_firefox",
            "profile": "firefox",
            "start_timeout_ms": 20000
          }
        },
        {
          "id": "svt-play",
          "title": "SVT Play",
          "launch": {
            "command": [
              "firefox",
              "--new-window",
              "https://www.svtplay.se/"
            ]
          },
          "handover": {
            "type": "window",
            "window_class": "Navigator firefox_firefox",
            "profile": "firefox",
            "start_timeout_ms": 20000
          }
        }
      ],
      "theme": "#4d9dff"
    },
    {
      "id": "games",
      "title": "Spel",
      "items": [
        {
          "id": "steam-big-picture",
          "title": "Steam",
          "subtitle": "Big Picture",
          "launch": {
            "command": [
              "steam",
              "-bigpicture"
            ]
          },
          "handover": {
            "type": "window",
            "window_class": "Steam",
            "start_timeout_ms": 30000
          }
        }
      ],
      "subcategories": [
        {"id": "snes", "title": "Super Nintendo"},
        {"id": "nes", "title": "Nintendo 8-bit"}
      ],
      "theme": "#f2a54a"
    }
  ],
  "emulators": [
    {
      "id": "snes9x",
      "title": "Super Nintendo",
      "category": "snes",
      "rom_dirs": [
        "/home/user/snes"
      ],
      "extensions": [
        ".sfc",
        ".smc"
      ],
      "command": [
        "flatpak",
        "run",
        "--filesystem=/home/user/snes",
        "com.snes9x.Snes9x",
        "{rom}"
      ],
      "handover": {
        "type": "window",
        "window_class": "snes9x-gtk Snes9x-gtk",
        "profile": "snes9x",
        "start_timeout_ms": 15000,
        "close_strategy": "graceful",
        "fullscreen": true
      }
    }
  ]
}
